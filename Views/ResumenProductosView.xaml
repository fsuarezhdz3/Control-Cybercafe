<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PuntoVenta2.Views.ResumenProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FiltroButton" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#3E3E3E">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE NAVEGACIÓN -->
        <Border Background="Black" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- IZQUIERDA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="15,0"
                    Grid.Column="0">
                    <Button Style="{StaticResource NavBtn}" Click="BtnOrdenes_Click">
                        <Image Source="/Images/ordenes.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnTiempos_Click">
                        <Image Source="/Images/tiempos.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>

                <!-- CENTRO: TÍTULO -->
                <TextBlock Text="Resumen de Productos Vendidos"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="1"/>

                <!-- DERECHA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"
                    Grid.Column="2">
                    <Button Style="{StaticResource NavBtn}" Click="BtnResumen_Click">
                        <Image Source="/Images/resumen.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnCuenta_Click">
                        <Image Source="/Images/cuenta.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PANEL DE FILTROS (SOLO PARA ADMIN) -->
        <Border x:Name="PanelFiltrosAdmin"
                Grid.Row="1"
                Background="#2C2C2C"
                Margin="20,15,20,10"
                Padding="15"
                CornerRadius="8"
                Visibility="Visible">
            <StackPanel>
                <TextBlock Text="Filtrar por período:"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnHoy" 
                            Style="{StaticResource FiltroButton}"
                            Content="Hoy"
                            Click="BtnFiltrarHoy_Click"/>

                    <Button x:Name="BtnAyer"
                            Style="{StaticResource FiltroButton}"
                            Content="Ayer"
                            Click="BtnFiltrarAyer_Click"/>

                    <Button x:Name="BtnSemana"
                            Style="{StaticResource FiltroButton}"
                            Content="Esta semana"
                            Click="BtnFiltrarSemana_Click"/>

                    <Button x:Name="BtnMes"
                            Style="{StaticResource FiltroButton}"
                            Content="Este mes"
                            Click="BtnFiltrarMes_Click"/>

                    <Button x:Name="BtnAnio"
                            Style="{StaticResource FiltroButton}"
                            Content="Este año"
                            Click="BtnFiltrarAnio_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- PRIMERA TABLA: RESUMEN POR PRODUCTO -->
        <Border Grid.Row="2" Margin="20,10,20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO RESUMEN -->
                <Border Grid.Row="0" Background="#1E1E1E" Padding="10" CornerRadius="5,5,0,0">
                    <TextBlock Text="Resumen por Producto"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- DATAGRID RESUMEN -->
                <DataGrid x:Name="GridResumenProductos"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#2C2C2C"
                          Foreground="White"
                          BorderBrush="#555555"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          CellStyle="{StaticResource DataGridCellStyle}">

                    <DataGrid.Columns>
                        <!-- CANTIDAD -->
                        <DataGridTextColumn Header="Cantidad"
                                            Binding="{Binding Cantidad}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"/>

                        <!-- CONCEPTO -->
                        <DataGridTextColumn Header="Producto"
                                            Binding="{Binding Producto}"
                                            Width="2*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"/>

                        <!-- COSTO UNITARIO -->
                        <DataGridTextColumn Header="Costo Unit."
                                            Binding="{Binding CostoUnitario, StringFormat=${0}}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"/>

                        <!-- TOTAL -->
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding Total, StringFormat=${0}}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- FECHA -->
                        <DataGridTextColumn x:Name="ColFechaResumen"
                                            Header="Fecha"
                                            Binding="{Binding Fecha, StringFormat=yyyy-MM-dd}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"
                                            Visibility="Collapsed"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- SEGUNDA TABLA: VENTAS INDIVIDUALES -->
        <Border Grid.Row="3" Margin="20,0,20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO DETALLE -->
                <Border Grid.Row="0" Background="#1E1E1E" Padding="10" CornerRadius="5,5,0,0">
                    <TextBlock Text="Detalle de Ventas"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- DATAGRID DETALLE -->
                <DataGrid x:Name="GridDetalleVentas"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#2C2C2C"
                          Foreground="White"
                          BorderBrush="#555555"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          MaxHeight="300">

                    <DataGrid.Columns>
                        <!-- CONCEPTO -->
                        <DataGridTextColumn Header="Producto"
                                            Binding="{Binding Concepto}"
                                            Width="2*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"/>

                        <!-- MONTO -->
                        <DataGridTextColumn Header="Monto"
                                            Binding="{Binding Monto, StringFormat=${0}}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- HORA -->
                        <DataGridTextColumn Header="Hora"
                                            Binding="{Binding Hora}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"/>

                        <!-- FECHA -->
                        <DataGridTextColumn x:Name="ColFechaDetalle"
                                            Header="Fecha"
                                            Binding="{Binding Fecha, StringFormat=yyyy-MM-dd}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"
                                            Visibility="Collapsed"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- TOTALES -->
        <Border Grid.Row="4"
                Background="#1F1F1F"
                Margin="20"
                Padding="20"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="Total productos vendidos:"
                               Foreground="#CCCCCC"
                               FontSize="14"/>
                    <TextBlock x:Name="TxtTotalProductos"
                               Text="0"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Total recaudado:"
                               Foreground="#CCCCCC"
                               FontSize="14"/>
                    <TextBlock x:Name="TxtTotalRecaudado"
                               Text="$0"
                               Foreground="#4CAF50"
                               FontSize="20"
                               FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>