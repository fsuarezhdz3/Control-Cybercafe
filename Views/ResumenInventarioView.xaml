<UserControl x:Class="PuntoVenta2.Views.ResumenInventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ESTILO ESPECIAL para celdas de la columna Producto -->
        <Style x:Key="ProductoCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#2C2C2C"/>
            <!-- FONDO OSCURO -->
            <Setter Property="Foreground" Value="White"/>
            <!-- TEXTO BLANCO -->
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CantidadCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ESTILO SIMPLIFICADO para el botón -->
        <Style x:Key="ProductoButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#4CAF50"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModalButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#3E3E3E">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE NAVEGACIÓN -->
        <Border Background="Black" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- IZQUIERDA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="15,0"
                    Grid.Column="0">
                    <Button Style="{StaticResource NavBtn}" Click="BtnOrdenes_Click">
                        <Image Source="/Images/ordenes.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnTiempos_Click">
                        <Image Source="/Images/tiempos.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>

                <!-- CENTRO: TÍTULO -->
                <TextBlock Text="Inventario de Productos"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="1"/>

                <!-- DERECHA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"
                    Grid.Column="2">
                    <Button Style="{StaticResource NavBtn}" Click="BtnResumen_Click">
                        <Image Source="/Images/resumen.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnCuenta_Click">
                        <Image Source="/Images/cuenta.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABLA DE INVENTARIO -->
        <Border Grid.Row="1" Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO -->
                <Border Grid.Row="0" Background="#1E1E1E" Padding="15" CornerRadius="8,8,0,0">
                    <TextBlock Text="Productos en Inventario"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- DATAGRID CON FONDO MEJORADO -->
                <DataGrid x:Name="GridInventario"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#2C2C2C"
                          Foreground="White"
                          BorderBrush="#555555"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          RowBackground="#2C2C2C"
                          AlternatingRowBackground="#262626">

                    <DataGrid.Columns>
                        <!-- CANTIDAD -->
                        <DataGridTextColumn Header="Cantidad"
                                            Binding="{Binding Inventario}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"
                                            CellStyle="{StaticResource CantidadCellStyle}"/>

                        <!-- CONCEPTO (BOTÓN CLICKABLE) - VERSIÓN MEJORADA -->
                        <DataGridTemplateColumn Header="Producto" Width="2*">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderStyle}"/>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource ProductoCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Nombre}"
                                            Style="{StaticResource ProductoButton}"
                                            Click="BtnEditarProducto_Click"
                                            Tag="{Binding}"
                                            ToolTip="Click para editar inventario"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- MODAL EDITAR INVENTARIO -->
        <Grid x:Name="ModalInventario" 
              Grid.RowSpan="2"
              Background="#80000000"
              Visibility="Collapsed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#3E3E3E"
                    Width="400"
                    CornerRadius="10"
                    Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO DEL MODAL -->
                    <TextBlock x:Name="ModalTitulo"
                               Text="Editar Inventario"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Grid.Row="0"
                               Margin="0,0,0,20"/>

                    <!-- PRODUCTO -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Producto:"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <Border Background="#2C2C2C" 
                                CornerRadius="5" 
                                Padding="10">
                            <TextBlock x:Name="TxtNombreProducto"
                                       Text=""
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- CANTIDAD ACTUAL -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="Cantidad actual:"
                                   Foreground="#CCCCCC"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <Border Background="#2C2C2C" 
                                CornerRadius="5" 
                                Padding="10">
                            <TextBlock x:Name="TxtCantidadActual"
                                       Text="0"
                                       Foreground="#4CAF50"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- NUEVA CANTIDAD -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,20">
                        <TextBlock Text="Nueva cantidad:"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtNuevaCantidad"
                                 Background="#2C2C2C"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Height="40"
                                 FontSize="16"
                                 PreviewTextInput="TxtCantidad_PreviewTextInput"
                                 TextAlignment="Center"/>
                    </StackPanel>

                    <!-- BOTÓN CONFIRMAR -->
                    <Button x:Name="BtnConfirmarInventario"
                            Grid.Row="4"
                            Content="Confirmar Cambio"
                            Style="{StaticResource ModalButton}"
                            Background="#4CAF50"
                            Foreground="White"
                            Click="BtnConfirmarInventario_Click"
                            Margin="0,0,0,10"/>

                    <!-- BOTÓN CANCELAR -->
                    <Button Content="Cancelar"
                            Grid.Row="5"
                            Style="{StaticResource ModalButton}"
                            Background="#666666"
                            Foreground="White"
                            Click="BtnCancelarModal_Click"/>

                    <!-- MENSAJE ERROR -->
                    <TextBlock x:Name="TxtMensajeError"
                               Text=""
                               Foreground="Red"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Grid.Row="6"
                               Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>