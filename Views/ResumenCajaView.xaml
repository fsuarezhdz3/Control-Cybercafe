<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PuntoVenta2.Views.ResumenCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CajaButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#3E3E3E">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE NAVEGACIÓN -->
        <Border Background="Black" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- IZQUIERDA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="15,0"
                    Grid.Column="0">
                    <Button Style="{StaticResource NavBtn}" Click="BtnOrdenes_Click">
                        <Image Source="/Images/ordenes.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnTiempos_Click">
                        <Image Source="/Images/tiempos.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>

                <!-- CENTRO: TÍTULO -->
                <TextBlock Text="Resumen de Caja"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="1"/>

                <!-- DERECHA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"
                    Grid.Column="2">
                    <Button Style="{StaticResource NavBtn}" Click="BtnResumen_Click">
                        <Image Source="/Images/resumen.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnCuenta_Click">
                        <Image Source="/Images/cuenta.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABLA DE RESUMEN DE CAJA -->
        <Border Grid.Row="1" Margin="40,20,40,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO -->
                <Border Grid.Row="0" Background="#1E1E1E" Padding="15" CornerRadius="8,8,0,0">
                    <TextBlock Text="Resumen de Caja del Día"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- TABLA -->
                <Border Grid.Row="1" Background="#2C2C2C" Padding="0" CornerRadius="0,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <!-- FILA 1: INICIO DE CORTE -->
                        <Border Grid.Row="0" Background="#2C2C2C" BorderBrush="#555555" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Inicio de corte"
                                           Foreground="White"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                                <TextBlock x:Name="TxtInicioCorte"
                                           Text="$0"
                                           Foreground="#4CAF50"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,20,0"/>
                            </Grid>
                        </Border>

                        <!-- FILA 2: VENTAS TOTALES -->
                        <Border Grid.Row="1" Background="#2C2C2C" BorderBrush="#555555" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ventas totales"
                                           Foreground="White"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                                <TextBlock x:Name="TxtVentasTotales"
                                           Text="$0"
                                           Foreground="#4CAF50"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,20,0"/>
                            </Grid>
                        </Border>

                        <!-- FILA 3: RETIROS DE DINERO -->
                        <Border Grid.Row="2" Background="#2C2C2C" BorderBrush="#555555" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Retiros de dinero"
                                           Foreground="White"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                                <TextBlock x:Name="TxtRetiros"
                                           Text="$0"
                                           Foreground="#FF5722"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,20,0"/>
                            </Grid>
                        </Border>

                        <!-- FILA 4: INGRESOS DE DINERO -->
                        <Border Grid.Row="3" Background="#2C2C2C" BorderBrush="#555555" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ingresos de dinero"
                                           Foreground="White"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                                <TextBlock x:Name="TxtIngresos"
                                           Text="$0"
                                           Foreground="#2196F3"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,20,0"/>
                            </Grid>
                        </Border>

                        <!-- FILA 5: TOTAL EN CAJA -->
                        <Border Grid.Row="4" Background="#2C2C2C" BorderBrush="#555555" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total en caja"
                                           Foreground="White"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                                <TextBlock x:Name="TxtTotalCaja"
                                           Text="$0"
                                           Foreground="#FFC107"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,20,0"/>
                            </Grid>
                        </Border>

                        <!-- LÍNEA DIVISORIA -->
                        <Border Grid.Row="5" Background="#555555" Margin="10,0,10,0"/>

                        <!-- INFORMACIÓN DEL CORTE -->
                        <Border Grid.Row="6" Background="#1F1F1F">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Corte #"
                                           Foreground="#CCCCCC"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtIdCorte"
                                           Text="0"
                                           Foreground="#FF9800"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="5,0,20,0"/>

                                <TextBlock Text="Iniciado: "
                                           Foreground="#CCCCCC"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtHoraInicio"
                                           Text="00:00"
                                           Foreground="White"
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- BOTONES DE ACCIÓN -->
        <Border Grid.Row="2" Background="#1F1F1F" Margin="20" Padding="20" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- BOTÓN AGREGAR DINERO -->
                <Button x:Name="BtnAgregarDinero"
                        Style="{StaticResource CajaButton}"
                        Width="150"
                        Background="#2196F3"
                        Foreground="White"
                        Content="Agregar dinero"
                        Click="BtnAgregarDinero_Click"
                        Margin="0,0,20,0"/>

                <!-- BOTÓN SACAR DINERO -->
                <Button x:Name="BtnSacarDinero"
                        Style="{StaticResource CajaButton}"
                        Width="150"
                        Background="#FF5722"
                        Foreground="White"
                        Content="Sacar dinero"
                        Click="BtnSacarDinero_Click"
                        Margin="0,0,20,0"/>

                <!-- BOTÓN FINALIZAR CORTE -->
                <Button x:Name="BtnFinalizarCorte"
                        Style="{StaticResource CajaButton}"
                        Width="150"
                        Background="#4CAF50"
                        Foreground="White"
                        Content="Finalizar corte"
                        Click="BtnFinalizarCorte_Click"/>
            </StackPanel>
        </Border>

        <!-- MODAL AGREGAR/SACAR DINERO -->
        <Border x:Name="ModalDinero"
                Grid.RowSpan="3"
                Background="#80000000"
                Visibility="Collapsed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#3E3E3E"
                    Width="400"
                    CornerRadius="10"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO DEL MODAL -->
                    <TextBlock x:Name="ModalTitulo"
                               Text=""
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Grid.Row="0"
                               Margin="0,0,0,20"/>

                    <!-- CONCEPTO -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Concepto:"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtConcepto"
                                 Background="#2C2C2C"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Height="35"
                                 FontSize="14"
                                 MaxLength="100"/>
                    </StackPanel>

                    <!-- CANTIDAD -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <TextBlock Text="Cantidad:"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtCantidad"
                                 Background="#2C2C2C"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Height="35"
                                 FontSize="14"
                                 PreviewTextInput="TxtCantidad_PreviewTextInput"/>
                    </StackPanel>

                    <!-- BOTÓN CONFIRMAR -->
                    <Button x:Name="BtnConfirmarDinero"
                            Grid.Row="3"
                            Content="Confirmar"
                            Height="40"
                            Background="#4CAF50"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="BtnConfirmarDinero_Click"
                            Margin="0,0,0,10"/>

                    <!-- BOTÓN CANCELAR -->
                    <Button Content="Cancelar"
                            Grid.Row="4"
                            Height="40"
                            Background="#666666"
                            Foreground="White"
                            FontSize="16"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="BtnCancelarModal_Click"/>

                    <!-- MENSAJE ERROR -->
                    <TextBlock x:Name="TxtMensajeError"
                               Text=""
                               Foreground="Red"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Grid.Row="5"
                               Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
    
    