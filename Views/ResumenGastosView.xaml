<UserControl x:Class="PuntoVenta2.Views.ResumenGastosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="FiltroButton" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ESTILOS ESPECÍFICOS PARA CADA TIPO DE CELDA -->
        <Style x:Key="CantidadCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="ConceptoCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="CostoCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="TotalCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="#FF5722"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="FechaCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AgregarButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#3E3E3E">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE NAVEGACIÓN -->
        <Border Background="Black" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- IZQUIERDA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="15,0"
                    Grid.Column="0">
                    <Button Style="{StaticResource NavBtn}" Click="BtnOrdenes_Click">
                        <Image Source="/Images/ordenes.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnTiempos_Click">
                        <Image Source="/Images/tiempos.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>

                <!-- CENTRO: TÍTULO -->
                <TextBlock Text="Gestión de Gastos"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="1"/>

                <!-- DERECHA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"
                    Grid.Column="2">
                    <Button Style="{StaticResource NavBtn}" Click="BtnResumen_Click">
                        <Image Source="/Images/resumen.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnCuenta_Click">
                        <Image Source="/Images/cuenta.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PANEL DE FILTROS -->
        <Border Grid.Row="1"
                Background="#2C2C2C"
                Margin="20,15,20,10"
                Padding="15"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Filtrar por período:"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnHoy" 
                            Style="{StaticResource FiltroButton}"
                            Content="Hoy"
                            Click="BtnFiltrarHoy_Click"/>

                    <Button x:Name="BtnAyer"
                            Style="{StaticResource FiltroButton}"
                            Content="Ayer"
                            Click="BtnFiltrarAyer_Click"/>

                    <Button x:Name="BtnSemana"
                            Style="{StaticResource FiltroButton}"
                            Content="Esta semana"
                            Click="BtnFiltrarSemana_Click"/>

                    <Button x:Name="BtnMes"
                            Style="{StaticResource FiltroButton}"
                            Content="Este mes"
                            Click="BtnFiltrarMes_Click"/>

                    <Button x:Name="BtnAnio"
                            Style="{StaticResource FiltroButton}"
                            Content="Este año"
                            Click="BtnFiltrarAnio_Click"/>

                    <Button x:Name="BtnTodo"
                            Style="{StaticResource FiltroButton}"
                            Content="Todo"
                            Click="BtnFiltrarTodo_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- TABLA DE GASTOS -->
        <Border Grid.Row="2" Margin="20,0,20,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO -->
                <Border Grid.Row="0" Background="#1E1E1E" Padding="15" CornerRadius="8,8,0,0">
                    <TextBlock Text="Historial de Gastos"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- DATAGRID CON ESTILOS MEJORADOS -->
                <DataGrid x:Name="GridGastos"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="#2C2C2C"
                          Foreground="White"
                          BorderBrush="#555555"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          RowBackground="#2C2C2C"
                          AlternatingRowBackground="#262626">

                    <DataGrid.Columns>
                        <!-- CANTIDAD -->
                        <DataGridTextColumn Header="Cantidad"
                                            Binding="{Binding Cantidad}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"
                                            CellStyle="{StaticResource CantidadCellStyle}"/>

                        <!-- CONCEPTO -->
                        <DataGridTextColumn Header="Concepto"
                                            Binding="{Binding Concepto}"
                                            Width="2*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"
                                            CellStyle="{StaticResource ConceptoCellStyle}"/>

                        <!-- COSTO UNITARIO -->
                        <DataGridTextColumn Header="Costo Unit."
                                            Binding="{Binding CostoUnitario, StringFormat=${0}}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"
                                            CellStyle="{StaticResource CostoCellStyle}"/>

                        <!-- TOTAL -->
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding Total, StringFormat=${0}}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"
                                            CellStyle="{StaticResource TotalCellStyle}"/>

                        <!-- FECHA -->
                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding Fecha, StringFormat=yyyy-MM-dd}"
                                            Width="*"
                                            HeaderStyle="{StaticResource DataGridHeaderStyle}"
                                            CellStyle="{StaticResource FechaCellStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- TOTAL DE GASTOS -->
        <Border Grid.Row="3"
                Background="#1F1F1F"
                Margin="20,0,20,10"
                Padding="20"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="Total de gastos en período:"
                               Foreground="#CCCCCC"
                               FontSize="14"/>
                    <TextBlock x:Name="TxtTotalGastos"
                               Text="$0"
                               Foreground="#FF5722"
                               FontSize="24"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Período mostrado:"
                               Foreground="#CCCCCC"
                               FontSize="14"/>
                    <TextBlock x:Name="TxtPeriodo"
                               Text="Todo"
                               Foreground="#FF9800"
                               FontSize="16"
                               FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- BOTÓN AGREGAR GASTO -->
        <Border Grid.Row="4"
                Background="#1F1F1F"
                Margin="20,0,20,20"
                Padding="20"
                CornerRadius="8">
            <StackPanel HorizontalAlignment="Center">
                <Button x:Name="BtnAgregarGasto"
                        Style="{StaticResource AgregarButton}"
                        Content="➕ Agregar Gasto"
                        Click="BtnAgregarGasto_Click"/>
            </StackPanel>
        </Border>

        <!-- MODAL AGREGAR GASTO -->
        <Grid x:Name="ModalGasto" 
              Grid.RowSpan="5"
              Background="#80000000"
              Visibility="Collapsed">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#3E3E3E"
                    Width="500"
                    CornerRadius="10"
                    Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO DEL MODAL -->
                    <TextBlock Text="Agregar Nuevo Gasto"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Grid.Row="0"
                               Margin="0,0,0,20"/>

                    <!-- CONCEPTO -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Concepto:"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtConceptoGasto"
                                 Background="#2C2C2C"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Height="35"
                                 FontSize="14"
                                 MaxLength="100"/>
                    </StackPanel>

                    <!-- CANTIDAD -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="Cantidad:"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtCantidadGasto"
                                 Background="#2C2C2C"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Height="35"
                                 FontSize="14"
                                 PreviewTextInput="TxtCantidad_PreviewTextInput"/>
                    </StackPanel>

                    <!-- COSTO POR UNIDAD -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock Text="Costo por unidad ($):"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtCostoUnitario"
                                 Background="#2C2C2C"
                                 Foreground="White"
                                 BorderThickness="0"
                                 Height="35"
                                 FontSize="14"
                                 PreviewTextInput="TxtCosto_PreviewTextInput"/>
                    </StackPanel>

                    <!-- TOTAL CALCULADO -->
                    <Border Grid.Row="4" 
                            Background="#2C2C2C" 
                            CornerRadius="5" 
                            Padding="10"
                            Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Total: "
                                       Foreground="#CCCCCC"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTotalCalculado"
                                       Text="$0"
                                       Foreground="#FF5722"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- BOTÓN CONFIRMAR -->
                    <Button x:Name="BtnConfirmarGasto"
                            Grid.Row="5"
                            Content="Confirmar Gasto"
                            Height="45"
                            Background="#FF5722"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="BtnConfirmarGasto_Click"
                            Margin="0,0,0,10"/>

                    <!-- BOTÓN CANCELAR -->
                    <Button Content="Cancelar"
                            Grid.Row="6"
                            Height="45"
                            Background="#666666"
                            Foreground="White"
                            FontSize="16"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="BtnCancelarModal_Click"/>

                    <!-- MENSAJE ERROR -->
                    <TextBlock x:Name="TxtMensajeError"
                               Text=""
                               Foreground="Red"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Grid.Row="7"
                               Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>