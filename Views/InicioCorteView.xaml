<UserControl x:Class="PuntoVenta2.Views.InicioCorteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- QUITA Height y Width -->

    <Grid Background="#3F3F3F">

        <!-- Barra superior -->
        <Border Background="Black"
                Height="50"
                VerticalAlignment="Top">
            <TextBlock Text="Corte"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Contenido central -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="300">

            <TextBlock Text="Inicio de corte"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="¿Con cuánto inicias tu corte?"
                       Foreground="White"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Campo monto -->
            <Border Background="Black"
                    CornerRadius="10"
                    Height="40"
                    Margin="0,0,0,20">
                <DockPanel VerticalAlignment="Center">

                    <TextBlock Text="$"
                               Foreground="White"
                               FontSize="16"
                               Margin="10,0,5,0"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtInicioCorte"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="16"
                             VerticalContentAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Botón confirmar -->
            <Button Content="Confirmar"
                    Height="35"
                    Background="Black"
                    Foreground="White"
                    FontSize="14"
                    Cursor="Hand"
                    BorderThickness="0"
                    Click="BtnConfirmar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>

    </Grid>
</UserControl>