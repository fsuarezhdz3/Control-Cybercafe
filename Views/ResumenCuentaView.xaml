<UserControl x:Class="PuntoVenta2.Views.ResumenCuentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CerrarSesionButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FF5722"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#3E3E3E">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE NAVEGACIÓN -->
        <Border Background="Black" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- IZQUIERDA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="15,0"
                    Grid.Column="0">
                    <Button Style="{StaticResource NavBtn}" Click="BtnOrdenes_Click">
                        <Image Source="/Images/ordenes.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnTiempos_Click">
                        <Image Source="/Images/tiempos.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>

                <!-- CENTRO: TÍTULO -->
                <TextBlock Text="Mi Cuenta"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="1"/>

                <!-- DERECHA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"
                    Grid.Column="2">
                    <Button Style="{StaticResource NavBtn}" Click="BtnResumen_Click">
                        <Image Source="/Images/resumen.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" BorderBrush="#4CAF50" BorderThickness="0,0,0,2">
                        <Image Source="/Images/cuenta.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO MÍNIMO -->
        <Border Grid.Row="1" Margin="40">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- ICONO DE CUENTA -->
                <Image Source="/Images/cuenta.png" 
                       Width="120" 
                       Height="120" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

                <!-- NOMBRE DEL USUARIO ACTUAL -->
                <TextBlock x:Name="TxtNombreUsuario"
                           Text=""
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- INFORMACIÓN ADICIONAL -->
                <TextBlock x:Name="TxtInfoAdicional"
                           Text=""
                           Foreground="#CCCCCC"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- BOTÓN CERRAR SESIÓN -->
                <Button x:Name="BtnCerrarSesion"
                        Style="{StaticResource CerrarSesionButton}"
                        Content="🔒 Cerrar Sesión"
                        Click="BtnCerrarSesion_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>