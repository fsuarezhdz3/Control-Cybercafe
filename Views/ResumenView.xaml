<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PuntoVenta2.Views.ResumenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Estilo para botones de navegación -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Estilo para botones de resumen (solo texto) -->
        <Style x:Key="ResumenButton" TargetType="Button">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#2C2C2C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#3E3E3E">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE NAVEGACIÓN -->
        <Border Background="Black" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- IZQUIERDA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="15,0"
                    Grid.Column="0">
                    <Button Style="{StaticResource NavBtn}" Click="BtnOrdenes_Click">
                        <Image Source="/Images/ordenes.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnTiempos_Click">
                        <Image Source="/Images/tiempos.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>

                <!-- CENTRO: TÍTULO -->
                <TextBlock Text="Resúmenes"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="1"/>

                <!-- DERECHA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"
                    Grid.Column="2">
                    <Button Style="{StaticResource NavBtn}"
                            BorderBrush="#4CAF50"
                            BorderThickness="0,0,0,2">
                        <Image Source="/Images/resumen.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnCuenta_Click">
                        <Image Source="/Images/cuenta.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO DE RESUMEN -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <TextBlock Text="Selecciona un resumen:"
                       Foreground="White"
                       FontSize="18"
                       Margin="0,0,0,30"/>

                <!-- PRIMERA FILA - BOTONES SIN ICONOS -->
                <WrapPanel HorizontalAlignment="Center">

                    <!-- BOTÓN TIEMPO -->
                    <Button x:Name="BtnResumenTiempo"
                        Style="{StaticResource ResumenButton}"
                        BorderBrush="#4CAF50"
                        Click="BtnResumenTiempo_Click"
                        Content="Tiempo"/>

                    <!-- BOTÓN PRODUCTOS -->
                    <Button x:Name="BtnResumenProductos"
                        Style="{StaticResource ResumenButton}"
                        BorderBrush="#4CAF50"
                        Click="BtnResumenProductos_Click"
                        Content="Productos"/>

                    <!-- BOTÓN CAJA -->
                    <Button x:Name="BtnResumenCaja"
                        Style="{StaticResource ResumenButton}"
                        BorderBrush="#4CAF50"
                        Click="BtnResumenCaja_Click"
                        Content="Caja"/>

                </WrapPanel>

                <!-- SEGUNDA FILA (solo para admin) -->
                <WrapPanel x:Name="PanelAdmin" 
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">

                    <!-- BOTÓN INVENTARIO -->
                    <Button x:Name="BtnResumenInventario"
                        Width="200"
                        Height="100"
                        Margin="15"
                        FontSize="20"
                        FontWeight="Bold"
                        Background="#2C2C2C"
                        Foreground="White"
                        BorderThickness="2"
                        BorderBrush="#FF9800"
                        Cursor="Hand"
                        Click="BtnResumenInventario_Click"
                        Content="Inventario"/>

                    <!-- BOTÓN FINANZAS -->
                    <Button x:Name="BtnResumenFinanzas"
                        Width="200"
                        Height="100"
                        Margin="15"
                        FontSize="20"
                        FontWeight="Bold"
                        Background="#2C2C2C"
                        Foreground="White"
                        BorderThickness="2"
                        BorderBrush="#2196F3"
                        Cursor="Hand"
                        Click="BtnResumenFinanzas_Click"
                        Content="Finanzas"/>

                    <!-- NUEVO BOTÓN: GASTOS -->
                    <Button x:Name="BtnResumenGastos"
                        Width="200"
                        Height="100"
                        Margin="15"
                        FontSize="20"
                        FontWeight="Bold"
                        Background="#2C2C2C"
                        Foreground="White"
                        BorderThickness="2"
                        BorderBrush="#FF5722"
                        Cursor="Hand"
                        Click="BtnResumenGastos_Click"
                        Content="Gastos"/>

                </WrapPanel>

                <!-- MENSAJE PARA USUARIOS NO ADMIN -->
                <TextBlock x:Name="TxtMensajeUsuario"
                       Text=""
                       Foreground="#CCCCCC"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,0"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>