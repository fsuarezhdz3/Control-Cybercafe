<UserControl x:Class="PuntoVenta2.Views.TiemposView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PuntoVenta2.Models">
    <!-- QUITA mc:Ignorable y d:DesignHeight/Width -->

    <UserControl.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Estilo para filas activas -->
        <Style x:Key="FilaActiva" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Activo}" Value="True">
                    <Setter Property="Background" Value="#1A5276"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para celdas del DataGrid -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Estilo para cabeceras -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#3E3E3E">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE NAVEGACIÓN -->
        <Border Background="Black" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- IZQUIERDA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="15,0"
                    Grid.Column="0">
                    <Button Style="{StaticResource NavBtn}" Click="BtnOrdenes_Click">
                        <Image Source="/Images/ordenes.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}">
                        <Image Source="/Images/tiempos.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>

                <!-- CENTRO: TÍTULO -->
                <TextBlock Text="Tiempos de Consolas"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="1"/>

                <!-- DERECHA: ICONOS -->
                <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"
                    Grid.Column="2">
                    <Button Style="{StaticResource NavBtn}" Click="BtnResumen_Click">
                        <Image Source="/Images/resumen.png" Width="26" Height="26"/>
                    </Button>
                    <Button Style="{StaticResource NavBtn}" Click="BtnCuenta_Click">
                        <Image Source="/Images/cuenta.png" Width="26" Height="26"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABLA DE CONSOLAS -->
        <Border Grid.Row="1" Margin="20">
            <DataGrid x:Name="GridConsolas"
                      ItemsSource="{Binding Consolas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="#2C2C2C"
                      Foreground="White"
                      BorderBrush="#555555"
                      RowStyle="{StaticResource FilaActiva}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      GridLinesVisibility="Horizontal"
                      SelectionChanged="GridConsolas_SelectionChanged">

                <DataGrid.Columns>
                    <!-- CONSOLA -->
                    <DataGridTextColumn Header="Consola"
                                        Binding="{Binding Consola}"
                                        Width="*"
                                        HeaderStyle="{StaticResource DataGridHeaderStyle}"/>

                    <!-- HORA INICIO -->
                    <DataGridTextColumn Header="Hora Inicio"
                                        Binding="{Binding HoraInicioStr}"
                                        Width="*"
                                        HeaderStyle="{StaticResource DataGridHeaderStyle}"/>

                    <!-- CRONÓMETRO -->
                    <DataGridTextColumn Header="Tiempo"
                                        Binding="{Binding TiempoTranscurridoStr}"
                                        Width="*"
                                        HeaderStyle="{StaticResource DataGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#4CAF50"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- HORA FIN ESTIMADA -->
                    <DataGridTextColumn Header="Termina a las"
                                        Binding="{Binding HoraFinEstimadaStr}"
                                        Width="*"
                                        HeaderStyle="{StaticResource DataGridHeaderStyle}"/>

                    <!-- COSTO -->
                    <DataGridTextColumn Header="Costo"
                                        Binding="{Binding CostoEstimadoStr}"
                                        Width="*"
                                        HeaderStyle="{StaticResource DataGridHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF9800"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- MODAL CONTROL TIEMPO -->
        <Grid x:Name="ModalOverlay" 
              Background="#80000000" 
              Visibility="Collapsed"
              Grid.RowSpan="2">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#3E3E3E"
                    Width="400"
                    CornerRadius="10"
                    Padding="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TÍTULO CON NOMBRE DE CONSOLA -->
                    <TextBlock x:Name="ModalTitulo"
                               Text=""
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Grid.Row="0"
                               Margin="0,0,0,20"/>

                    <!-- INFORMACIÓN DE TIEMPO -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Información del tiempo:"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <!-- Si está inactivo, mostrar campo para dinero -->
                        <StackPanel x:Name="PanelInactivo" Visibility="Visible">
                            <TextBlock Text="Dinero a pagar ($20 por hora):"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="txtDinero"
                                     Text="20"
                                     Background="#2C2C2C"
                                     Foreground="White"
                                     BorderThickness="0"
                                     Height="35"
                                     FontSize="16"
                                     PreviewTextInput="TxtDinero_PreviewTextInput"/>
                        </StackPanel>

                        <!-- Si está activo, mostrar tiempo restante -->
                        <StackPanel x:Name="PanelActivo" Visibility="Collapsed">
                            <TextBlock Text="Tiempo transcurrido:"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="txtTiempoTranscurrido"
                                       Text="00:00:00"
                                       Foreground="#4CAF50"
                                       FontSize="20"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Tiempo restante:"
                                       Foreground="#CCCCCC"
                                       Margin="0,10,0,5"/>
                            <TextBlock x:Name="txtTiempoRestante"
                                       Text="00:00:00"
                                       Foreground="#FF5722"
                                       FontSize="20"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Costo actual:"
                                       Foreground="#CCCCCC"
                                       Margin="0,10,0,5"/>
                            <TextBlock x:Name="txtCostoActual"
                                       Text="$0"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- BOTÓN ACCIÓN PRINCIPAL -->
                    <Button x:Name="btnAccionPrincipal"
                            Grid.Row="2"
                            Content="Comenzar Tiempo"
                            Height="45"
                            Background="#4CAF50"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="BtnAccionPrincipal_Click"
                            Margin="0,0,0,10"/>

                    <!-- BOTÓN CANCELAR -->
                    <Button Content="Cancelar"
                            Grid.Row="3"
                            Height="45"
                            Background="#666666"
                            Foreground="White"
                            FontSize="16"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="BtnCancelarModal_Click"/>

                    <!-- ESTADO -->
                    <TextBlock x:Name="txtEstado"
                               Text=""
                               Foreground="#CCCCCC"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Grid.Row="4"
                               Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>